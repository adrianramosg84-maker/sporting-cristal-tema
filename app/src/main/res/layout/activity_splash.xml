<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#00AEEF"
    android:padding="32dp">

    <TextView
        android:id="@+id/splash_stars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★   ★   ★"
        android:textSize="32sp"
        android:textColor="#FFD700"
        android:layout_marginBottom="16dp"/>

    <ImageView
        android:id="@+id/splash_shield"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/escudo_sc"
        android:scaleType="fitCenter"/>

    <TextView
        android:id="@+id/splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SPORTING CRISTAL"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/splash_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LA RAZA CELESTE"
        android:textSize="14sp"
        android:textColor="#CCFFFFFF"
        android:layout_marginTop="8dp"/>

    <ProgressBar
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:indeterminate="true"
        android:indeterminateTint="#FFD700"/>

</LinearLayout>
