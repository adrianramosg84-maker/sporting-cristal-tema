<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/celeste_sc"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FONDOS DE PANTALLA"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/dorado"
        android:fontFamily="serif"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"
        android:shadowColor="#7a5c00"
        android:shadowDx="2" android:shadowDy="2" android:shadowRadius="3"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona qué deseas cambiar"
        android:textSize="13sp"
        android:textColor="#CCFFFFFF"
        android:layout_marginBottom="40dp"/>

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/escudo_sc"
        android:scaleType="fitCenter"
        android:layout_marginBottom="40dp"
        android:elevation="6dp"/>

    <Button
        android:id="@+id/btn_apply_wallpaper"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="📱  FONDO PANTALLA DE INICIO"
        android:textColor="@color/navy"
        android:textStyle="bold"
        android:backgroundTint="@color/dorado"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"/>

    <Button
        android:id="@+id/btn_apply_lockscreen"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="🔒  FONDO PANTALLA DE BLOQUEO"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:backgroundTint="@color/celeste_dark"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"/>

    <Button
        android:id="@+id/btn_apply_both"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="⚽  APLICAR EN AMBAS PANTALLAS"
        android:textColor="@color/navy"
        android:textStyle="bold"
        android:backgroundTint="@color/dorado"
        android:elevation="4dp"/>

</LinearLayout>
